# Copy to .env.local for local dev, and set these in the Vercel project settings.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sending identity. The domain must be verified in Resend
# (https://resend.com/domains) before mail will deliver.
MAIL_FROM="Owensboro Home Expo <noreply@owensborohomeexpo.com>"

# Where form submissions land. Comma-separate for multiple recipients.
MAIL_TO=adam@greenriverbia.com
